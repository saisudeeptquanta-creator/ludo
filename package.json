{
  "name": "ludo-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Real-time multiplayer Ludo — human players only, server-authoritative.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
