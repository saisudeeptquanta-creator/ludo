# Copy to .env and adjust. All values have safe development defaults.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_FILE=./data/ludo.db

SESSION_TTL_HOURS=24
REMEMBER_TTL_DAYS=30

TURN_DURATION_MS=20000
RECONNECT_GRACE_MS=90000

# Seeded admin account (created by `npm run seed`)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ludo.local
ADMIN_PASSWORD=ChangeMe123!
